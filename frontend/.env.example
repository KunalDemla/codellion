# API base including its prefix. A relative URL works with the dev proxy or a same-origin deployment.
VITE_API_BASE_URL=/api

# Optional Vite dev/preview proxy destination. Leave blank if the API is already at VITE_API_BASE_URL.
API_PROXY_TARGET=http://127.0.0.1:5000

# Optional timeout for each HTTP request in milliseconds.
VITE_API_REQUEST_TIMEOUT_MS=8000

# Optional answer catalog path relative to VITE_API_BASE_URL. Blank uses this default.
VITE_ANSWER_REVIEW_PATH=/games/{runId}/results/rounds/{roundNumber}/answers
